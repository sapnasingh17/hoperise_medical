# Hope Rise Medical System Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# SMTP Configuration (Production / Staging / Local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_SECURE=tls
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Hope Rise Medical

# Common Port & Encryption Options:
# Port 587 -> TLS
# Port 465 -> SSL
# Port 25 / 1025 -> none
